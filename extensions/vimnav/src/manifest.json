{
  "manifest_version": 3,
  "name": "VimNav",
  "version": "1.0.0",
  "description": "Lightweight vim navigation for browsing. Enter normal mode, then use vim motions to scroll and jump around.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VimNav — toggle navigation mode"
  },
  "commands": {
    "toggle-vim": {
      "suggested_key": {
        "default": "Alt+V",
        "mac": "Command+Shift+V"
      },
      "description": "Toggle VimNav normal mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}